# Public domain (DNS A/AAAA pointing to the VPS): Caddy obtains the HTTPS certificate.
DOMAIN=agora.example.com

# UID/GID owning the Hermes data (leave as is unless needed).
HERMES_UID=10000
HERMES_GID=10000
# Running versions: kept up to date by the update service.
APP_VERSION=0.8.2
HERMES_VERSION=v2026.9.21
TZ=Europe/Paris

# App images: "agora" = built on the server (./agora build);
# later "ghcr.io/<user>/agora" + a registry read token.
AGORA_IMAGE_PREFIX=agora
REGISTRY_USER=
REGISTRY_TOKEN=

# Secrets: generate each one with `openssl rand -hex 32`.
POSTGRES_PASSWORD=
BETTER_AUTH_SECRET=
HERMES_API_KEY=
HERMES_DASHBOARD_TOKEN=
HERMES_KEY_SECRET=
UPDATER_TOKEN=


# Email invitations (Resend, verified domain). Empty = link shown to the admin.
RESEND_API_KEY=
MAIL_FROM="Agora <no-reply@example.com>"

# Setup wizard installation code. Empty = drawn at random at startup and
# printed in the API logs (./agora setup-code).
# AGORA_SETUP_TOKEN=

# Off-site backups (./agora backup-offsite, restic, encrypted client-side).
# Repository: s3:https://s3.<region>.amazonaws.com/<bucket>/agora, b2:<bucket>:agora,
# sftp:user@host:/srv/agora-backups … Any S3-compatible storage works too
# (Cloudflare R2, Scaleway, self-hosted MinIO or Garage): s3:https://<endpoint>/<bucket>/agora
# with AWS_DEFAULT_REGION (R2: auto). Keep RESTIC_PASSWORD somewhere else too:
# without it the backups can't be read.
# RESTIC_REPOSITORY=
# RESTIC_PASSWORD=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=
# B2_ACCOUNT_ID=
# B2_ACCOUNT_KEY=
