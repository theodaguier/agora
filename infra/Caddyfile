{
	# Behind Cloudflare (orange cloud): uncomment so that the API, and its rate
	# limiting, sees the visitor's IP rather than Cloudflare's. Ranges:
	# https://www.cloudflare.com/ips/ (see DEPLOY.md, Security).
	# servers {
	# 	trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
	# 	client_ip_headers CF-Connecting-IP
	# }
}

{$DOMAIN} {
	encode zstd gzip

	# Access logs (JSON on stdout): read by CrowdSec on the host, when installed,
	# to ban scanners and brute-force attempts (DEPLOY.md, Security).
	log {
		output stdout
		format json
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		# The app uses none of these; clipboard stays allowed (copy buttons).
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), serial=(), bluetooth=(), midi=(), interest-cohort=()"
		# Isolates the window from pages that open it; "allow-popups" keeps the
		# connector OAuth tab (marketplace/use-mcp-oauth.ts) watchable.
		Cross-Origin-Opener-Policy same-origin-allow-popups
		-Server
	}

	# API (and SSE reply streams): the API shares the hermes container's network.
	# No page CSP here: attachments send their own (sandbox).
	handle /api/* {
		request_body {
			max_size 30MB
		}
		reverse_proxy hermes:3001 {
			flush_interval -1
		}
	}

	# Web app. Scripts: only the app's own files (no inline script, no eval).
	# Images and videos: https allowed, agents' replies show pictures from the web;
	# data:/blob: for the agent screen frames and upload previews.
	# Styles: inline allowed (UI libraries inject <style> and style attributes).
	handle {
		header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; media-src 'self' blob: https:; font-src 'self' data:; connect-src 'self'; worker-src 'self' blob:; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
