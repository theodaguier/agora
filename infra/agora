#!/usr/bin/env bash
# Agora operations tool (can be run from anywhere).
#   agora build            builds the app/web/updater images at the repo version
#   agora up               starts (or updates) the whole stack
#   agora status           service status and versions
#   agora logs [service]   logs
#   agora contract         checks the production Hermes contract
#   agora setup-code       installation code asked by the setup wizard (blank instance)
#   agora backup-offsite   encrypted copy (restic) of the database, Hermes data and .env
#   agora restore-check    checks the off-site repository and test-restores the database
set -euo pipefail
INFRA="$(cd "$(dirname "$0")" && pwd)"
ROOT="$(cd "$INFRA/.." && pwd)"
cd "$INFRA"
# .env holds every secret of the instance: readable by its owner only.
chmod 600 .env 2>/dev/null || true
set -a; source .env; set +a
PREFIX="${AGORA_IMAGE_PREFIX:-agora}"
compose() { docker compose -p agora "$@"; }

RESTIC_IMAGE="restic/restic:0.18.0"
# Variables restic reads (repository, password, cloud credentials), passed only if set.
restic_run() {
  : "${RESTIC_REPOSITORY:?RESTIC_REPOSITORY is missing in infra/.env}"
  : "${RESTIC_PASSWORD:?RESTIC_PASSWORD is missing in infra/.env}"
  local envs=() name
  for name in RESTIC_REPOSITORY RESTIC_PASSWORD AWS_ACCESS_KEY_ID AWS_SECRET_ACCESS_KEY AWS_DEFAULT_REGION \
    B2_ACCOUNT_ID B2_ACCOUNT_KEY AZURE_ACCOUNT_NAME AZURE_ACCOUNT_KEY GOOGLE_PROJECT_ID; do
    [ -n "${!name:-}" ] && envs+=(-e "$name")
  done
  local ssh=()
  # SFTP repository: the server's SSH keys and known_hosts.
  [[ "$RESTIC_REPOSITORY" == sftp:* ]] && ssh=(-v "$HOME/.ssh:/root/.ssh:ro")
  # Fixed --host: snapshots group by host, and a container's hostname is random.
  docker run --rm -i --cpus=1 --memory=512m -e GOGC=50 ${envs[@]+"${envs[@]}"} ${ssh[@]+"${ssh[@]}"} -v agora_restic-cache:/root/.cache/restic --hostname agora "$@"
}

case "${1:-}" in
  build)
    VERSION="$(sed -n 's/.*"version": "\(.*\)".*/\1/p' "$ROOT/package.json" | head -1)"
    COMMIT="$(git -C "$ROOT" rev-parse --short HEAD 2>/dev/null || echo "")"
    NOW="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    args=(--build-arg "APP_VERSION=$VERSION" --build-arg "GIT_COMMIT=$COMMIT" --build-arg "BUILT_AT=$NOW")
    docker build "${args[@]}" -f "$ROOT/apps/api/Dockerfile" -t "$PREFIX-app:$VERSION" "$ROOT"
    docker build "${args[@]}" -f "$INFRA/web.Dockerfile" -t "$PREFIX-web:$VERSION" "$ROOT"
    docker build "${args[@]}" -f "$ROOT/apps/updater/Dockerfile" -t "$PREFIX-updater:$VERSION" "$ROOT"
    echo "Images $PREFIX-{app,web,updater}:$VERSION built."
    echo "To deploy them: APP_VERSION=$VERSION in infra/.env then 'agora up' (or via Admin › Updates)."
    ;;
  up) compose up -d --build --remove-orphans ;;
  status)
    compose ps --format 'table {{.Service}}\t{{.State}}\t{{.Status}}\t{{.Image}}'
    echo "app ${APP_VERSION} · hermes ${HERMES_VERSION}"
    ;;
  logs) shift; compose logs -f --tail 100 "$@" ;;
  contract)
    compose exec -T api bun src/hermes-contract.ts --chat
    ;;
  setup-code)
    code="$(compose logs --no-log-prefix api 2>/dev/null | sed -n 's/.*Agora installation code: *\([^ ]*\).*/\1/p' | tail -1)"
    if [ -z "$code" ]; then
      echo "No installation code in the API logs: the instance is already set up, or the API hasn't started yet ('./agora logs api')." >&2
      exit 1
    fi
    echo "$code"
    ;;
  backup-offsite)
    # systemd and manual runs must not share or delete each other's staging.
    # Keep the lock in this trusted directory, with no truncation of an existing file.
    # A read-only fd also lets the repo owner lock a file first created by root.
    lock="$INFRA/.backup-offsite.lock"
    (umask 022; set -o noclobber; : > "$lock") 2>/dev/null || [ -f "$lock" ]
    exec 9<"$lock"
    flock -n 9 || { echo "An off-site backup is already running." >&2; exit 75; }
    # Repository created on first use.
    restic_run "$RESTIC_IMAGE" cat config >/dev/null 2>&1 || restic_run "$RESTIC_IMAGE" init
    echo "Database…"
    compose exec -T postgres pg_dump -U agora --clean --if-exists agora \
      | restic_run "$RESTIC_IMAGE" backup --host agora --tag db --stdin --stdin-filename agora-db.sql
    echo "Hermes data, update backups and .env…"
    # A compressed local snapshot keeps SQLite consistent without requiring space
    # for a second uncompressed Hermes volume. Hermes resumes before the upload.
    # Package caches are left out, as in the updater's backups
    # (apps/updater/src/backup.ts): several GB rebuilt by the next install. With
    # them, the copy filled the disk, Hermes stayed paused and Postgres went down.
    staging=agora_restic-staging
    archive_container="agora-offsite-archive-$$"
    docker volume create "$staging" >/dev/null
    hermes="$(compose ps -q hermes)"
    paused=false
    # Never leave Hermes paused nor the copy on disk, even if this script fails.
    # set +e: under errexit, the unpause of a running Hermes (always the case at
    # the end) aborted the trap before the volume removal, and failed the run.
    # Failed file snapshots still leave a successful DB snapshot. Apply retention on failure too,
    # after removing staging, and retain the original failure status for systemd/monitoring.
    trap 'status=$?; set +e; docker rm -f "$archive_container" >/dev/null 2>&1; $paused && docker unpause "$hermes" >/dev/null 2>&1; docker volume rm -f "$staging" >/dev/null 2>&1; if (( status != 0 )); then restic_run "$RESTIC_IMAGE" forget --host agora --keep-daily 7 --keep-weekly 4 --keep-monthly 6 --prune; fi; exit "$status"' EXIT
    # Reserve 1 GiB for Postgres and other writers. The kernel file-size limit
    # aborts the archive before it can consume this reserve, even if compression is poor.
    space="$(docker run --rm -v agora_hermes-data:/from:ro -v "$staging:/to:ro" alpine timeout 120 sh -ec '
      df -Pk /to | awk "END { print \$4 }"
    ')" || { echo "Cannot estimate backup space: Hermes was not paused." >&2; exit 1; }
    available="$space"
    [[ "$available" =~ ^[0-9]+$ ]] || { echo "Invalid backup space estimate." >&2; exit 1; }
    if (( available <= 1048576 )); then
      echo "Not enough space for the Hermes snapshot: 1 GiB reserve required, available $available KiB. Hermes was not paused." >&2
      exit 1
    fi
    max_bytes=$(( (available - 1048576) * 1024 ))
    if [ -n "$hermes" ]; then
      docker pause "$hermes" >/dev/null
      paused=true
    fi
    copied=true
    docker run --rm --name "$archive_container" --cpus=1 --memory=256m --ulimit "fsize=$max_bytes:$max_bytes" \
      -v agora_hermes-data:/from:ro -v "$staging:/to" alpine timeout 1200 sh -c '
      set -o pipefail
      find /to -mindepth 1 -delete
      mkdir -p /to/backups /to/env
      touch /to/env/.env
      tar -C /from -cf - --exclude=node_modules --exclude=.venv --exclude=.npm --exclude=.cache \
        --exclude=.next --exclude=.nuxt --exclude=.svelte-kit --exclude=.expo --exclude=.turbo \
        --exclude="*/.bun/install/cache" --exclude="*/.local/share/pnpm" . | gzip -1 > /to/hermes-data.tgz' || copied=false
    if $paused; then
      docker unpause "$hermes" >/dev/null
      paused=false
    fi
    $copied || { echo "Copy of the Hermes data failed: nothing sent." >&2; exit 1; }
    # New snapshots contain /data/hermes-data.tgz; old directory snapshots remain restorable.
    restic_run -v "$staging:/data:ro" -v agora_backups:/data/backups:ro -v "$INFRA/.env:/data/env/.env:ro" \
      "$RESTIC_IMAGE" backup --host agora --tag files --ignore-inode --ignore-ctime /data
    docker volume rm "$staging" >/dev/null
    restic_run "$RESTIC_IMAGE" forget --host agora --keep-daily 7 --keep-weekly 4 --keep-monthly 6 --prune
    echo "Off-site backup done."
    ;;
  restore-check)
    restic_run "$RESTIC_IMAGE" snapshots --host agora
    restic_run "$RESTIC_IMAGE" check --read-data-subset=5%
    # Real test: the latest dump restored into a throwaway Postgres.
    name="agora-restore-check-$$"
    docker run -d --rm --name "$name" --cpus=0.5 --memory=512m --tmpfs /var/lib/postgresql/data -e POSTGRES_USER=agora -e POSTGRES_PASSWORD=check -e POSTGRES_DB=agora postgres:17-alpine >/dev/null
    trap 'docker rm -f "$name" >/dev/null 2>&1 || true' EXIT
    deadline=$((SECONDS + 60))
    until docker exec "$name" pg_isready -U agora -d agora >/dev/null 2>&1; do
      (( SECONDS < deadline )) || { echo "Restore-check Postgres did not start." >&2; exit 1; }
      sleep 1
    done
    sleep 2
    restic_run "$RESTIC_IMAGE" dump --host agora --tag db latest /agora-db.sql \
      | docker exec -i "$name" psql -U agora -d agora -v ON_ERROR_STOP=1 -q >/dev/null
    users="$(docker exec "$name" psql -U agora -d agora -tAc 'select count(*) from "user"')"
    echo "Database restored from the latest off-site snapshot: $users account(s)."
    if restic_run "$RESTIC_IMAGE" ls --host agora --tag files latest /data/hermes-data.tgz | grep '/data/hermes-data.tgz$' >/dev/null; then
      restic_run "$RESTIC_IMAGE" dump --host agora --tag files latest /data/hermes-data.tgz \
        | docker run --rm -i --network=none --memory=512m --entrypoint /opt/hermes/.venv/bin/python \
          -v "$INFRA/verify-hermes-backup.py:/verify.py:ro" "${HERMES_REPO:-nousresearch/hermes-agent}:${HERMES_VERSION}" /verify.py
    fi
    ;;
  *) sed -n '2,10p' "$0"; exit 1 ;;
esac
