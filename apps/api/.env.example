PORT=3001
DATABASE_URL=postgres://agora:agora@localhost:5440/agora

# openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3001
WEB_ORIGIN=http://localhost:5173

# Hermes API server (gateway multiplex_profiles). Empty = simulated replies.
HERMES_API_URL=
# Default profile key; HERMES_KEY_<PROFILE> for a named profile (e.g. HERMES_KEY_COMPTA).
HERMES_API_KEY=


# Email invitations (Resend). Empty = the invitation link is shown to the admin instead of being sent.
RESEND_API_KEY=
MAIL_FROM="Agora <no-reply@example.com>"

# Hermes instance root (attachments, profile config)
HERMES_HOME=
# Headless Hermes dashboard (MCP, skills): same token as HERMES_DASHBOARD_SESSION_TOKEN
HERMES_DASHBOARD_URL=http://127.0.0.1:9129
HERMES_DASHBOARD_TOKEN=
# Secret used to derive API keys for profiles created from the admin
HERMES_KEY_SECRET=

# Company memory vault (agents' shared wiki). Empty = $HERMES_HOME/wiki
WIKI_DIR=

# Claude Code engine (`claude` binary logged in with `claude /login` on this machine).
# Personal subscription: only this account can choose it, in its private conversations. Empty = disabled.
CLAUDE_CODE_OWNER_EMAIL=
CLAUDE_CODE_BIN=claude
# Sessions workspace; empty = ~/.agora/claude-code
CLAUDE_CODE_CWD=
CLAUDE_CODE_ALLOWED_TOOLS=WebSearch WebFetch

# Codex engine (`codex` binary, ChatGPT subscription). Owner: empty = CLAUDE_CODE_OWNER_EMAIL.
CODEX_OWNER_EMAIL=
CODEX_BIN=codex
# Sessions workspace; empty = ~/.agora/codex
CODEX_CWD=

# Modèles locaux de la machine hôte (Réglages › Modèles). En Docker : http://host.docker.internal:11434
OLLAMA_URL=http://127.0.0.1:11434
LMSTUDIO_URL=http://127.0.0.1:1234
