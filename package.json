{
  "name": "agora",
  "version": "0.67.0",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "infra/dev.sh",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "db:up": "docker compose -f infra/docker-compose.dev.yml up -d",
    "db:down": "docker compose -f infra/docker-compose.dev.yml down",
    "hermes": "infra/hermes-dev.sh",
    "release": "bun scripts/release.ts",
    "dev:apps": "turbo run dev --filter=!@agora/updater"
  },
  "devDependencies": {
    "turbo": "^2.11.11",
    "typescript": "^7.0.2"
  },
  "license": "AGPL-3.0-only",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "source-map-js@<1.2.2": "^1.2.2",
    "shell-quote@<1.11.0": "^1.11.0",
    "@modelcontextprotocol/sdk@<1.31.0": "^1.31.0",
    "zod@>=4.0.0 <4.6.6": "^4.6.7",
    "body-parser@>=2.0.0 <2.4.0": "^2.4.0",
    "undici@>=7.18.0 <7.30.1": "^7.30.1",
    "ip-address@>=10.0.0 <10.7.4": "^10.7.4",
    "fast-uri@>=3.0.0 <3.1.9": "^3.1.9",
    "seroval@<1.6.11": "~1.6.12",
    "@modelcontextprotocol/sdk>zod": "^4.6.7",
    "zod-to-json-schema>zod": "^4.6.7"
  }
}
